# LLM Configuration
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL="poolside/laguna-s-2.1:free"

# Database
DATABASE_URL=sqlite:///database/jobs.db

# Application Targets
DAILY_APPLICATION_TARGET=25
DAILY_APPLICATION_MIN=20
DAILY_APPLICATION_MAX=30

# Matching
MIN_MATCH_SCORE=75

# Browser
HEADLESS=false
AUTO_SUBMIT=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# ATS API Keys (set these to enable ATS sources)
# Greenhouse - get from Greenhouse API settings
GREENHOUSE_API_KEY=

# Lever - get from Lever API credentials
LEVER_API_KEY=

# Workday - get from Workday API credentials (username:password or OAuth token)
WORKDAY_API_KEY=

# iCIMS - get from iCIMS OAuth credentials (format: client_id:client_secret)
ICIMS_API_KEY=

# SmartRecruiters - get from SmartRecruiters API token
SMARTRECRUITERS_API_KEY=