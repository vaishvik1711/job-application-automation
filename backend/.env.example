# LLM Configuration — ANTHROPIC_MODEL is the single source of truth.
# Change it here (or in .claude/settings.json) and it propagates everywhere.
ANTHROPIC_MODEL=poolside/laguna-s-2.1:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# LLM_MODEL is kept as a legacy alias; if set it is used when ANTHROPIC_MODEL is absent.
LLM_MODEL=${ANTHROPIC_MODEL}

# Database
DATABASE_URL=postgresql://user:password@your-supabase-host:5432/your-database-name

# Application Targets
DAILY_APPLICATION_TARGET=25
DAILY_APPLICATION_MIN=20
DAILY_APPLICATION_MAX=30

# Matching
MIN_MATCH_SCORE=75

# Browser / Auto-Apply
# HEADLESS must be true on Railway (no display). false only for local debugging.
HEADLESS=true
# Master switch for automatic submission. When false, only MANUAL mode works
# (bot fills the form, parks it, and waits for you to confirm the final Submit).
AUTO_SUBMIT=false
# Max simultaneous browser apply sessions (keep at 1 on Railway — memory)
MAX_CONCURRENT_APPLIES=1

# Credential encryption — REQUIRED before storing any job-site logins.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A non-Fernet value is treated as a passphrase (sha256-derived), so any long
# random string also works. Rotating this invalidates stored passwords.
CREDENTIAL_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=

# ATS API Keys (set these to enable ATS sources)
# Greenhouse - get from Greenhouse API settings
GREENHOUSE_API_KEY=

# Lever - get from Lever API credentials
LEVER_API_KEY=

# Workday - get from Workday API credentials (username:password or OAuth token)
WORKDAY_API_KEY=

# iCIMS - get from iCIMS OAuth credentials (format: client_id:client_secret)
ICIMS_API_KEY=

# SmartRecruiters - get from SmartRecruiters API token
SMARTRECRUITERS_API_KEY=

# CORS Origins - your Cloudflare Pages frontend URL
CORS_ORIGINS=https://job-application-automation.pages.dev,https://job-application-automation.pages.dev
