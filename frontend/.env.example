# API Configuration - your Railway backend URL
VITE_API_URL=https://your-backend-name.up.railway.app

# Supabase Configuration - from supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LLM model (same value as backend ANTHROPIC_MODEL)
VITE_ANTHROPIC_MODEL=deepseek/deepseek-v4-flash
